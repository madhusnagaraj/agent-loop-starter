# Agent Loop Starter — configuration knobs.
# Copy to .env and fill in. Never commit real values (.env is gitignored).

# --- Repository ---
AGENT_REPO=owner/repo                 # the GitHub repo the loop operates on
AGENT_BASE_BRANCH=main                # the integration branch (gets branch protection)

# --- Gates (§ external enforcement) ---
# Comma-separated GitHub logins allowed to apply gate labels (ready / approved).
# Set this as a repo variable too: gh api -X POST repos/$AGENT_REPO/actions/variables -f name=AGENT_GATE_MAINTAINERS -f value="..."
AGENT_GATE_MAINTAINERS=your-handle
# The dedicated bot account the worker pushes/opens PRs as (NOT a human).
AGENT_BOT_LOGIN=your-agent-bot

# --- Credential isolation (§ boundary control) ---
# The preflight probes that this identity CANNOT read the privileged secret.
# Point these at YOUR secret names; the write one must be denied to the loop identity.
AGENT_DENY_SECRET=app-write-credentials
AGENT_READ_SECRET=app-readonly-credentials
AWS_REGION=us-east-1
# Not on AWS? Provide an adapter command that exits 0 ONLY when the privileged secret is
# confirmed DENIED to this identity (e.g. a vault/gcloud probe). Gate 4 is fail-closed: with
# neither the aws CLI nor this set, the preflight refuses rather than skipping the boundary.
# AGENT_SECRET_PROBE_CMD='vault kv get -field=x secret/app-write 2>&1 | grep -q "permission denied"'

# --- Content controls (§ what the preflight can't probe from outside your app) ---
# The fail-closed side-effect fence, synthetic-only data provenance, and structural-drift
# detection live in YOUR send path / data layer — the preflight can't reach them. Set this to 1
# only once they are genuinely wired and active; Gate 5 fails closed until you attest.
AGENT_CONTENT_CONTROLS_ACK=0

# --- Validation environment ---
# How a worker proves a change: a local docker stack OR a cloud dev environment.
AGENT_ENV_MODE=docker                 # docker | cloud
